# Proof-server target. Leave empty to use the local proof server in Docker.
# Read by two parties: the browser bundle (via import.meta.env) and the
# /proof-server proxy of the production server (server/index.ts). Deliberately
# one variable, so the privacy indicator in the UI names the host that is
# actually contacted.
#
# WARNING: the proof server receives the witness — the voter's credential and
# vote choice. Pointing this at someone else's server means that server's
# operator can see every vote. Set it only if you accept that consequence; the
# UI will disclose it openly to the user.
#
# VITE_PROOF_SERVER_URL=https://proof-server.example.test

# Extra hosts allowed to reach the dev server, comma-separated. Needed when you
# proxy the dev server through a tunnel or a custom domain; Vite rejects
# unknown hosts as DNS-rebinding protection. A leading dot covers every
# subdomain. `.mdloglabs.org` is already included by default.
#
# VITE_ALLOWED_HOSTS=.example.test,tunnel.trycloudflare.com
#
# The warning that goes with it: once this page is served through a tunnel or
# a custom domain, it no longer originates from the voter's device.
# VITE_PROOF_SERVER_URL is resolved by the Node process running the server, so
# `http://127.0.0.1:6300` means THAT machine's loopback — not the voter's. The
# witness (credential and vote choice) travels browser → internet → tunnel →
# that machine, and whoever operates it can see every vote. The privacy
# indicator in the sidebar will stop claiming "Always on" and name that hop as
# it is; do not silence the warning.

# The Midnight network the app READS. Valid values: preprod, preview,
# undeployed. Leave empty for the default (preview).
#
# This is not a preference: the VotePriv registry exists on ONE network, and
# reading the wrong one yields "registry not found" — not an empty list.
# Verified: the registry address returns null on preprod and a populated object
# on preview.
#
# VITE_MIDNIGHT_NETWORK=preview

# Registry contract address, hex without the 0x prefix. Leave empty to use the
# deployed default. The whole ballot list comes from registry.ballots
# (spec §2.3), so a wrong address means the app sees no ballot at all.
#
# VITE_VOTEPRIV_REGISTRY=c42681741bff50e346b9e80493b622c57883f748cc0a3af60f71545e6f8ff35a

# Organiser CLI (pkgs/cli) — set on the command line, never in a committed file:
#   VOTEPRIV_SELF_REGISTRATION=1   deploy a ballot with empty seats; voters register their own leaf
#   VOTEPRIV_INBOX_URL=https://…   seal the registration inbox address into the ballot policy
#   VOTEPRIV_ELIGIBLE_COUNT=16     seats (1..1024; default 3)
#   VOTEPRIV_VOTE_MINUTES=4320     voting window in minutes (default 120)
#   VOTEPRIV_TALLY_MINUTES=7200    tally deadline in minutes (default 180; must exceed the vote window)
#   VOTEPRIV_REDEPLOY=1            allow deploying a new registry/ballot when the artefact already has one
#   VOTEPRIV_BALLOT=<address>      ballot to serve (register-leaves, register-inbox) instead of the artefact's
#   VOTEPRIV_INBOX_PORT=5390       port of `pnpm cli register-inbox` (bound to 127.0.0.1)
# The wallet seed is never an environment variable here — the CLI reads it from a no-echo prompt.
