{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preprod": "node --max-old-space-size=4096 --no-warnings --experimental-strip-types src/preprod.ts",
    "preprod-ps": "docker compose -f proof-server.yml up -d && pnpm preprod",
    "preview": "node --max-old-space-size=4096 --no-warnings --experimental-strip-types src/preview.ts",
    "deploy-registry": "node --max-old-space-size=4096 --no-warnings --experimental-strip-types src/deploy-registry.ts",
    "deploy-ballot": "node --max-old-space-size=4096 --no-warnings --experimental-strip-types src/deploy-ballot.ts",
    "register-leaves": "node --max-old-space-size=4096 --no-warnings --experimental-strip-types src/register-leaves.ts",
    "e2e": "node --max-old-space-size=4096 --no-warnings --experimental-strip-types src/e2e.ts",
    "doctor": "node --no-warnings --experimental-strip-types src/doctor.ts",
    "ekspor-cadangan": "node --no-warnings --experimental-strip-types src/ekspor-cadangan.ts",
    "build": "rm -rf dist && tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-abstractions": "^2.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "^3.0.1",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^3.1.0",
    "@scure/bip39": "^2.4.0",
    "contract": "workspace:*",
    "shared": "workspace:*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.2",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/ws": "^8.0.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.4"
  }
}
