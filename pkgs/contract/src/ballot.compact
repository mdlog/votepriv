pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum BallotPhase { voting, tallying, finalized }

// ── Metadata, sealed at deploy ───────────────────────────────────────────
export sealed ledger title:             Opaque<"string">;
export sealed ledger description:       Opaque<"string">;
export sealed ledger community:         Opaque<"string">;
export sealed ledger option0:           Opaque<"string">;
export sealed ledger option1:           Opaque<"string">;
export sealed ledger option2:           Opaque<"string">;
export sealed ledger option3:           Opaque<"string">;
export sealed ledger optionCount:       Uint<8>;

// voteDeadline and tallyDeadline: SECONDS since the Unix epoch
// (secondsSinceEpoch), NOT milliseconds. This is not a style choice —
// onchain-runtime-v3 declares secondsSinceEpoch: bigint as the block-time unit
// on a real node, and kernel.blockTimeLessThan/blockTimeGreaterThan compare that
// value against these ledgers as-is, with no scaling (confirmed empirically,
// Task 5). If these are deployed in milliseconds (e.g. straight from Date.now(),
// ~1000x larger than seconds), the effective deadline is never reached within a
// human time span — the deadline asserts silently never fail — and the failure
// is NOT visible through the simulator: the simulator can be made self-consistent
// under either convention (ms or seconds), so every test stays green while the
// ballot deployed for real is broken.
export sealed ledger voteDeadline:      Uint<64>;
export sealed ledger tallyDeadline:     Uint<64>;

// METADATA ONLY — NOT ENFORCED BY ANY CIRCUIT.
// quorumPercent is written once in the constructor and never read again by any
// circuit in this file. finalize() succeeds at 0% participation exactly as it
// does at 100%: no code path compares voteCount or talliedCount against this
// value. Treat it as a publicly auditable note ("the quorum the organiser
// intended"), NOT as a binding threshold — do not show it in a UI as if the
// contract would reject a result below it, because the contract rejects
// nothing. The only thing the contract enforces is that the value makes sense
// as a percentage (assert quorum <= 100 in the constructor), so the number
// displayed is not nonsense. Enforcing quorum is a product decision deliberately
// kept separate from this note.
export sealed ledger quorumPercent:     Uint<8>;
export sealed ledger eligibleCount:     Uint<64>;
export sealed ledger eligibilityPolicy: Opaque<"string">;
export sealed ledger adminKey:          Bytes<32>;
export sealed ledger ballotNonce:       Bytes<32>;

export ledger phase: BallotPhase;

// ── Eligibility ──────────────────────────────────────────────────────────
// HistoricMerkleTree rather than MerkleTree: when the admin registers voters in
// several batches, the root changes between batches. checkRoot() accepts an
// older root, so a path a voter has already built stays valid.
export ledger eligibility: HistoricMerkleTree<10, Bytes<32>>;

// ── Voting phase ─────────────────────────────────────────────────────────
export ledger voteCount: Counter;

// Number of credentials issued so far. HistoricMerkleTree does not expose
// firstFree()/size() inside a circuit (both are runtime-only on compactc
// 0.31.1), so the eligibleCount bound is enforced through this parallel Counter,
// which always grows by exactly the number of leaves inserted in the same
// transaction. The value is public, so the number of credentials issued stays
// auditable by anyone through this ledger.
//
// INVARIANT: registeredCount == number of leaves in eligibility, always.
// The two are paired state guaranteed by nothing but discipline — no type and no
// compiler stops a new circuit from changing one without the other. If they
// drift apart, the eligibleCount bound stops meaning anything and the admin can
// issue more credentials than the count sealed at deploy. Therefore: every
// circuit that calls eligibility.insert() MUST increment registeredCount by the
// number of inserts, in the same transaction. Today only registerVoters touches
// either; castVote only reads through checkRoot and touches neither.
export ledger registeredCount: Counter;

export ledger nullifiers: Set<Bytes<32>>;
// Plain MerkleTree, not Historic: this tree is already frozen when the tally
// phase starts, because castVote is only allowed before the deadline and
// tallyVote only after it.
export ledger commitments: MerkleTree<10, Bytes<32>>;

// ── Tally phase ──────────────────────────────────────────────────────────
// There is no separate closeVoting circuit. The voting -> tallying transition
// is made lazily by tallyVote() itself, triggered by the first voter to open a
// vote — see the comment on tallyVote() for why (liveness trap).
export ledger tallyNullifiers: Set<Bytes<32>>;
export ledger tallies:         Map<Uint<8>, Uint<64>>;
export ledger talliedCount:    Counter;

witness admin_secret_key(): Bytes<32>;
witness voter_credential(): Bytes<32>;
witness eligibility_path(): MerkleTreePath<10, Bytes<32>>;
witness get_my_option(): Uint<8>;
witness get_my_salt(): Bytes<32>;
witness store_opening(o: Uint<8>, s: Bytes<32>): [];
witness commitment_path(): MerkleTreePath<10, Bytes<32>>;

// ── Domain-separated hashes ──────────────────────────────────────────────
// All `export pure` so TypeScript can call them through pureCircuits, and the
// client never has to re-implement Compact's hashing.

export pure circuit admin_pk(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "votepriv:pk:v1"), sk]);
}

export pure circuit cred_leaf(cred: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "votepriv:cred:v1"), cred]);
}

export pure circuit vote_nullifier(nonce: Bytes<32>, cred: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "votepriv:nf:v1"), nonce, cred]);
}

export pure circuit vote_commitment(option: Uint<8>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "votepriv:vote:v1"),
    (option as Field) as Bytes<32>,
    salt
  ]);
}

export pure circuit tally_nullifier(salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "votepriv:tnf:v1"), salt]);
}

// ── Constructor ──────────────────────────────────────────────────────────
// ALL validation precedes ALL ledger writes, the same pattern as
// castVote/tallyVote. It carries more weight here than in any circuit: every
// field written below is `sealed`, so a wrong value can NEVER be corrected
// after deploy. The only way out of a misconfigured ballot is to deploy a new
// one and abandon the old — together with every vote already cast into it.
constructor(
  t: Opaque<"string">,
  d: Opaque<"string">,
  c: Opaque<"string">,
  o0: Opaque<"string">,
  o1: Opaque<"string">,
  o2: Opaque<"string">,
  o3: Opaque<"string">,
  nOptions: Uint<8>,
  voteDl: Uint<64>,
  tallyDl: Uint<64>,
  quorum: Uint<8>,
  eligible: Uint<64>,
  policy: Opaque<"string">,
  nonce: Bytes<32>
) {
  // Spec §5.1 fixes 2..4 options, and this ledger only has option0..option3.
  // Above 4, castVote would accept an option with no on-chain label at all:
  // assert(option < optionCount) passes, tallies[option] fills up, and the
  // result contains a row nobody reading the ledger can name. Below 2, the
  // ballot offers no choice at all.
  assert(nOptions >= 2 && nOptions <= 4, "Option count must be between 2 and 4");

  // tallyDeadline MUST come after voteDeadline. Otherwise the two tallyVote
  // guards — blockTime > voteDeadline AND blockTime < tallyDeadline — are never
  // true at the same time, so every vote cast becomes PERMANENTLY UNOPENABLE.
  // What makes this expensive: finalize() still succeeds, so such a ballot is
  // published as final with voteCount > 0 and talliedCount == 0 and empty
  // tallies, without a single marker in the ledger that it is dead.
  assert(tallyDl > voteDl, "Tally deadline must be after the vote deadline");

  // eligibleCount == 0 yields a ballot that can never accept a single
  // credential (registerVoters rejects them all), so nobody can ever vote in it.
  assert(eligible >= 1, "Eligible voter count must be at least 1");

  // The eligibility tree holds 2^10 = 1024 leaves (Merkle depth 10). Without
  // this bound a larger eligibleCount is accepted silently and registration
  // fails on the 1025th leaf with "exceeded structure bounds" from the runtime —
  // an internal error that explains nothing, rather than one of this contract's
  // own rejection messages.
  assert(eligible <= 1024, "Eligible voter count exceeds the tree capacity (1024)");

  // A percentage above 100 has no meaning. This is the ONLY thing the contract
  // enforces about quorumPercent — see the note on its declaration.
  assert(quorum <= 100, "Quorum percent cannot exceed 100");

  title             = disclose(t);
  description       = disclose(d);
  community         = disclose(c);
  option0           = disclose(o0);
  option1           = disclose(o1);
  option2           = disclose(o2);
  option3           = disclose(o3);
  optionCount       = disclose(nOptions);
  voteDeadline      = disclose(voteDl);
  tallyDeadline     = disclose(tallyDl);
  quorumPercent     = disclose(quorum);
  eligibleCount     = disclose(eligible);
  eligibilityPolicy = disclose(policy);
  ballotNonce       = disclose(nonce);
  adminKey          = disclose(admin_pk(admin_secret_key()));
  phase             = BallotPhase.voting;
}

// Admin only. Closes itself as soon as the first vote lands, so the voter list
// cannot change in the middle of voting.
export circuit registerVoters(leaves: Vector<8, Bytes<32>>, n: Uint<8>): [] {
  assert(disclose(admin_pk(admin_secret_key()) == adminKey), "Only the admin can register voters");
  assert(phase == BallotPhase.voting, "Ballot is no longer in the voting phase");
  assert(voteCount.read() == 0, "Registration is closed once the first vote is cast");
  assert(n >= 1 && n <= 8, "Batch size must be between 1 and 8");

  // registeredCount is public, so anyone can check the number of credentials
  // actually issued against the sealed eligibleCount.
  const used = registeredCount.read();
  assert(used + (n as Uint<64>) <= eligibleCount, "Registration would exceed the ballot's eligibleCount");

  // Unrolled by hand rather than a for-loop, to avoid depending on loop syntax.
  // Each branch condition is disclosed because the decision to insert or not is
  // itself a conditional ledger operation — compactc 0.31.1 requires explicit
  // disclosure for any boolean that decides whether a ledger operation runs.
  if (disclose(n > 0)) { eligibility.insert(disclose(leaves[0])); }
  if (disclose(n > 1)) { eligibility.insert(disclose(leaves[1])); }
  if (disclose(n > 2)) { eligibility.insert(disclose(leaves[2])); }
  if (disclose(n > 3)) { eligibility.insert(disclose(leaves[3])); }
  if (disclose(n > 4)) { eligibility.insert(disclose(leaves[4])); }
  if (disclose(n > 5)) { eligibility.insert(disclose(leaves[5])); }
  if (disclose(n > 6)) { eligibility.insert(disclose(leaves[6])); }
  if (disclose(n > 7)) { eligibility.insert(disclose(leaves[7])); }

  registeredCount.increment(disclose(n as Uint<16>));
}

// Called by a voter. Proves membership in the eligibility tree in zero
// knowledge, burns a nullifier so the same credential cannot be used twice,
// then records the vote commitment. All validation runs before any ledger
// mutation, so no state is left half-changed when an assert fails.
export circuit castVote(): [] {
  assert(kernel.blockTimeLessThan(voteDeadline), "Vote deadline has passed");
  // This phase assert has the same status as the phase assert in tallyVote (see
  // the long note above that circuit): there is no state that ONLY this guard
  // rejects. phase leaves voting only through tallyVote (needs block time >
  // voteDeadline) or finalize (needs block time > tallyDeadline), and block time
  // never goes backwards — so whenever phase != voting, the deadline guard one
  // line above has already failed too, and because it is written first, its
  // message is the one the user actually sees.
  //
  // The difference from tallyVote: here that guarantee RESTS on the
  // tallyDl > voteDl assert in the constructor. Without it, a ballot with
  // tallyDeadline < voteDeadline could be finalized while block time is still
  // < voteDeadline, and in that state this phase assert is the only thing that
  // rejects. So this line is not merely a statement of intent.
  assert(phase == BallotPhase.voting, "Ballot is not accepting votes");

  const cred = voter_credential();
  const leaf = cred_leaf(cred);
  const path = eligibility_path();

  // Proves the credential is in the eligibility tree without revealing it.
  assert(disclose(path.leaf == leaf), "Merkle path does not belong to this credential");
  const rt: MerkleTreeDigest = disclose(merkleTreePathRoot<10, Bytes<32>>(path));
  assert(eligibility.checkRoot(rt), "Credential is not registered on this ballot");

  const option = get_my_option();
  const salt = get_my_salt();
  assert(disclose(option < optionCount), "Option is out of range");

  // One credential, one vote.
  const nf: Bytes<32> = disclose(vote_nullifier(ballotNonce, cred));
  assert(!nullifiers.member(nf), "Credential has already voted");
  nullifiers.insert(nf);

  // Only a hash enters the ledger. Not a single bit about the choice.
  commitments.insert(disclose(vote_commitment(option, salt)));
  voteCount.increment(1);

  // Kept locally so the voter can open their vote in the tally phase.
  store_opening(option, salt);
}

// Called by a voter, after voteDeadline, to open their own vote commitment.
// Proves in zero knowledge that the commitment being opened is in the
// commitments tree, WITHOUT revealing which one — only the chosen option becomes
// public. The tally nullifier is derived from the salt, not from the
// commitment, so there is no way to link "one vote for option X" back to any
// commitment, let alone to the voter — this is what keeps the opening
// untraceable even once the result is published.
//
// There is no separate closeVoting circuit. The voting -> tallying transition
// is made lazily by the first voter to open a vote, inside this circuit — not
// through a dedicated closing circuit. A closing circuit would create a
// liveness trap: if nobody ever called it, no vote could ever be opened, and
// the ballot would die with all of its votes intact but uncountable.
//
// NOTE (Task 7, CORRECTED during the branch-review fix wave).
// The correct claim about the phase != finalized assert on the first line of
// this circuit is about REACH, not about order: there is no state that ONLY
// this guard rejects. Once finalize() has succeeded, block time is certainly
// > tallyDeadline (that is finalize's own precondition) and block time never
// goes backwards, so the blockTimeLessThan(tallyDeadline) guard is certain to
// fail in the same state as well.
//
// An earlier version wrote that the tallyDeadline guard "ALWAYS rejects first".
// That was WRONG and dangerous as a premise: evaluation follows the written
// order, and the phase assert is written first. After finalization the message
// the user actually receives is "Ballot is already finalized" — not "Tally
// deadline has passed". Anyone reordering or removing guards here must reason
// from that fact, not from the wrong premise.
//
// The line is kept precisely because its message explains the situation to the
// user more accurately, and as defence in depth should the time guards ever
// change.
export circuit tallyVote(): [] {
  assert(phase != BallotPhase.finalized, "Ballot is already finalized");
  assert(kernel.blockTimeGreaterThan(voteDeadline), "Voting is still open");
  assert(kernel.blockTimeLessThan(tallyDeadline), "Tally deadline has passed");

  const option = get_my_option();
  const salt = get_my_salt();
  const c    = vote_commitment(option, salt);
  const path = commitment_path();

  // Proves this commitment is in the tree, without revealing which one.
  assert(disclose(path.leaf == c), "Merkle path does not belong to this commitment");
  const rt: MerkleTreeDigest = disclose(merkleTreePathRoot<10, Bytes<32>>(path));
  assert(commitments.checkRoot(rt), "Commitment not found on this ballot");

  // The tally nullifier is derived from the secret salt — NOT from the
  // commitment. This is what makes "one vote for option X" unlinkable to any
  // commitment, let alone to the voter.
  const tnf: Bytes<32> = disclose(tally_nullifier(salt));
  assert(!tallyNullifiers.member(tnf), "Vote has already been opened");

  // Every validation above has passed; only now is the ledger mutated.
  // Phase transition first (see the comment above this circuit), then the
  // nullifier, then the tally itself.
  if (phase == BallotPhase.voting) { phase = BallotPhase.tallying; }

  tallyNullifiers.insert(tnf);

  const publicOption: Uint<8> = disclose(option);
  if (tallies.member(publicOption)) {
    tallies.insert(publicOption, (tallies.lookup(publicOption) + 1) as Uint<64>);
  } else {
    tallies.insert(publicOption, 1);
  }
  talliedCount.increment(1);
}

// Open to anyone once tallyDeadline has passed — not just the admin, because
// finalization only records a fact that is already public (tallyDeadline has
// passed), not a decision that needs authorisation. It gives finality an
// explicit on-chain marker instead of leaving it as a time derivation on the
// display side.
//
// Accepted from any phase other than finalized — DELIBERATELY NOT
// assert(phase == BallotPhase.tallying, ...). phase only moves to tallying
// lazily when the first voter to open a vote calls tallyVote (see the comment
// on tallyVote). A ballot in which no vote was ever opened (e.g. no voter came
// back after voteDeadline) stays in the voting phase forever; requiring
// phase == tallying here would make such a ballot impossible to finalize at
// all — exactly the liveness trap that is the reason closeVoting was dropped as
// a separate circuit (see the comment on tallyVote).
export circuit finalize(): [] {
  assert(phase != BallotPhase.finalized, "Ballot is already finalized");
  assert(kernel.blockTimeGreaterThan(tallyDeadline), "Tally deadline has not passed yet");
  phase = BallotPhase.finalized;
}
