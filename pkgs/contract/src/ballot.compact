pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum BallotPhase { voting, tallying, finalized }

// ── Metadata, di-seal saat deploy ────────────────────────────────────────
export sealed ledger title:             Opaque<"string">;
export sealed ledger description:       Opaque<"string">;
export sealed ledger community:         Opaque<"string">;
export sealed ledger option0:           Opaque<"string">;
export sealed ledger option1:           Opaque<"string">;
export sealed ledger option2:           Opaque<"string">;
export sealed ledger option3:           Opaque<"string">;
export sealed ledger optionCount:       Uint<8>;

// voteDeadline dan tallyDeadline: DETIK sejak epoch Unix (secondsSinceEpoch),
// BUKAN milidetik. Ini bukan pilihan gaya — onchain-runtime-v3 mendeklarasikan
// secondsSinceEpoch: bigint sebagai satuan waktu blok pada node sungguhan, dan
// kernel.blockTimeLessThan/blockTimeGreaterThan membandingkan nilai ini mentah-
// mentah terhadap ledger ini, tanpa skala apa pun (dikonfirmasi empiris, Task 5).
// Bila nilai ini di-deploy dalam milidetik (mis. dari Date.now() langsung, ~1000x
// lebih besar dari detik), deadline efektif tidak akan pernah tercapai dalam
// rentang waktu manusia — assert deadline diam-diam tidak pernah gagal — dan
// kegagalan ini TIDAK akan terlihat lewat simulator: simulator dapat dibuat
// konsisten sendiri di bawah kedua konvensi (ms atau detik), sehingga seluruh
// uji tetap hijau sementara ballot yang di-deploy sungguhan rusak.
export sealed ledger voteDeadline:      Uint<64>;
export sealed ledger tallyDeadline:     Uint<64>;

// METADATA SAJA — TIDAK DITEGAKKAN OLEH CIRCUIT MANA PUN.
// quorumPercent ditulis sekali di constructor lalu tidak pernah dibaca lagi oleh
// circuit mana pun di berkas ini. finalize() berhasil pada partisipasi 0% persis
// seperti pada 100%: tidak ada satu jalur kode pun yang membandingkan voteCount
// atau talliedCount terhadap nilai ini. Perlakukan sebagai keterangan yang dapat
// diaudit publik ("kuorum yang dimaksudkan penyelenggara"), BUKAN sebagai ambang
// yang mengikat — jangan menampilkannya di UI seolah-olah kontrak akan menolak
// hasil yang berada di bawahnya, karena kontrak tidak menolak apa pun.
// Satu-satunya hal yang ditegakkan kontrak adalah bahwa nilainya masuk akal
// sebagai persen (assert quorum <= 100 di constructor), sehingga angka yang
// ditampilkan bukan omong kosong. Menegakkan kuorum adalah keputusan produk yang
// sengaja diambil terpisah dari perbaikan ini.
export sealed ledger quorumPercent:     Uint<8>;
export sealed ledger eligibleCount:     Uint<64>;
export sealed ledger eligibilityPolicy: Opaque<"string">;
export sealed ledger adminKey:          Bytes<32>;
export sealed ledger ballotNonce:       Bytes<32>;

export ledger phase: BallotPhase;

// ── Eligibility ──────────────────────────────────────────────────────────
// HistoricMerkleTree, bukan MerkleTree: bila admin mendaftarkan voter dalam
// beberapa batch, root berubah di antara batch. checkRoot() menerima root lama
// sehingga path yang sudah disusun voter tetap sah.
export ledger eligibility: HistoricMerkleTree<10, Bytes<32>>;

// ── Fase vote ────────────────────────────────────────────────────────────
export ledger voteCount: Counter;

// Jumlah credential yang sudah diterbitkan. HistoricMerkleTree tidak mengekspos
// firstFree()/size() ke dalam circuit (keduanya runtime-only pada compactc
// 0.31.1) sehingga batas eligibleCount ditegakkan lewat Counter paralel ini,
// yang selalu bertambah persis sebanyak leaf yang di-insert pada transaksi
// yang sama. Nilainya publik, sehingga jumlah credential yang diterbitkan
// tetap dapat diaudit siapa pun lewat ledger ini.
//
// INVARIAN: registeredCount == jumlah leaf di dalam eligibility, selalu.
// Keduanya adalah state berpasangan yang tidak dijamin apa pun selain disiplin —
// tidak ada tipe maupun compiler yang mencegah circuit baru mengubah salah satu
// tanpa yang lain. Bila keduanya berpisah, batas eligibleCount berhenti bermakna
// dan admin dapat menerbitkan credential melebihi jumlah yang di-seal saat deploy.
// Karena itu: setiap circuit yang memanggil eligibility.insert() WAJIB menambah
// registeredCount sebanyak jumlah insert-nya, di transaksi yang sama. Saat ini
// hanya registerVoters yang menyentuh keduanya; castVote hanya membaca lewat
// checkRoot dan tidak menyentuh satu pun.
export ledger registeredCount: Counter;

export ledger nullifiers: Set<Bytes<32>>;
// MerkleTree biasa, bukan Historic: pohon ini sudah beku saat fase tally dimulai,
// karena castVote hanya boleh sebelum deadline dan tallyVote hanya sesudahnya.
export ledger commitments: MerkleTree<10, Bytes<32>>;

// ── Fase tally ───────────────────────────────────────────────────────────
// Tidak ada circuit closeVoting terpisah. Transisi voting -> tallying dilakukan
// secara malas oleh tallyVote() itu sendiri, dipicu pembuka suara pertama —
// lihat komentar di tallyVote() untuk alasannya (jebakan liveness).
export ledger tallyNullifiers: Set<Bytes<32>>;
export ledger tallies:         Map<Uint<8>, Uint<64>>;
export ledger talliedCount:    Counter;

witness admin_secret_key(): Bytes<32>;
witness voter_credential(): Bytes<32>;
witness eligibility_path(): MerkleTreePath<10, Bytes<32>>;
witness get_my_option(): Uint<8>;
witness get_my_salt(): Bytes<32>;
witness store_opening(o: Uint<8>, s: Bytes<32>): [];
witness commitment_path(): MerkleTreePath<10, Bytes<32>>;

// ── Hash berpemisah domain ───────────────────────────────────────────────
// Semuanya `export pure` agar dapat dipanggil TypeScript lewat pureCircuits,
// sehingga klien tidak perlu mengimplementasi ulang hashing Compact.

export pure circuit admin_pk(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "votepriv:pk:v1"), sk]);
}

export pure circuit cred_leaf(cred: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "votepriv:cred:v1"), cred]);
}

export pure circuit vote_nullifier(nonce: Bytes<32>, cred: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "votepriv:nf:v1"), nonce, cred]);
}

export pure circuit vote_commitment(option: Uint<8>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "votepriv:vote:v1"),
    (option as Field) as Bytes<32>,
    salt
  ]);
}

export pure circuit tally_nullifier(salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "votepriv:tnf:v1"), salt]);
}

// ── Constructor ──────────────────────────────────────────────────────────
// SELURUH validasi mendahului SELURUH penulisan ledger, pola yang sama dengan
// castVote/tallyVote. Di sini bobotnya lebih berat daripada di circuit mana pun:
// setiap field yang ditulis di bawah bersifat `sealed`, sehingga nilai yang
// keliru TIDAK PERNAH bisa diperbaiki setelah deploy. Satu-satunya jalan keluar
// dari ballot yang salah konfigurasi adalah men-deploy ballot baru dan
// meninggalkan yang lama — beserta seluruh suara yang sudah masuk ke dalamnya.
constructor(
  t: Opaque<"string">,
  d: Opaque<"string">,
  c: Opaque<"string">,
  o0: Opaque<"string">,
  o1: Opaque<"string">,
  o2: Opaque<"string">,
  o3: Opaque<"string">,
  nOptions: Uint<8>,
  voteDl: Uint<64>,
  tallyDl: Uint<64>,
  quorum: Uint<8>,
  eligible: Uint<64>,
  policy: Opaque<"string">,
  nonce: Bytes<32>
) {
  // Spec §5.1 menetapkan 2..4 opsi, dan ledger ini hanya punya option0..option3.
  // Di atas 4, castVote menerima opsi yang sama sekali tidak punya label on-chain:
  // assert(opsi < optionCount) lolos, tallies[opsi] terisi, dan hasilnya memuat
  // baris yang tidak dapat diberi nama oleh siapa pun yang membaca ledger.
  // Di bawah 2, ballot tidak menawarkan pilihan apa pun.
  assert(nOptions >= 2 && nOptions <= 4, "Jumlah opsi harus 2 sampai 4");

  // tallyDeadline WAJIB melewati voteDeadline. Bila tidak, kedua guard tallyVote
  // — blockTime > voteDeadline DAN blockTime < tallyDeadline — tidak pernah benar
  // bersamaan, sehingga setiap suara yang masuk menjadi PERMANEN TIDAK DAPAT
  // DIBUKA. Yang membuatnya mahal: finalize() tetap berhasil, jadi ballot semacam
  // itu terbit sebagai ballot final dengan voteCount > 0 dan talliedCount == 0
  // serta tallies kosong, tanpa satu pun penanda di ledger bahwa ia sudah mati.
  assert(tallyDl > voteDl, "Batas waktu pembukaan suara harus setelah batas waktu pemungutan suara");

  // eligibleCount == 0 menghasilkan ballot yang tidak pernah bisa menerima satu
  // credential pun (registerVoters menolak semuanya), jadi tidak ada yang bisa
  // memilih di dalamnya selamanya.
  assert(eligible >= 1, "Jumlah pemilih yang berhak minimal 1");

  // Kapasitas pohon eligibility adalah 2^10 = 1024 daun (Merkle depth 10).
  // Tanpa batas ini, eligibleCount yang lebih besar diterima diam-diam dan
  // pendaftaran baru gagal pada daun ke-1025 dengan "exceeded structure bounds"
  // dari runtime — galat internal yang tidak menjelaskan apa pun, bukan salah
  // satu pesan penolakan milik kontrak ini.
  assert(eligible <= 1024, "Jumlah pemilih yang berhak melebihi kapasitas pohon (1024)");

  // Persen di atas 100 tidak punya arti. Ini SATU-SATUNYA hal yang ditegakkan
  // kontrak atas quorumPercent — lihat catatan pada deklarasinya.
  assert(quorum <= 100, "Persentase kuorum tidak boleh melebihi 100");

  title             = disclose(t);
  description       = disclose(d);
  community         = disclose(c);
  option0           = disclose(o0);
  option1           = disclose(o1);
  option2           = disclose(o2);
  option3           = disclose(o3);
  optionCount       = disclose(nOptions);
  voteDeadline      = disclose(voteDl);
  tallyDeadline     = disclose(tallyDl);
  quorumPercent     = disclose(quorum);
  eligibleCount     = disclose(eligible);
  eligibilityPolicy = disclose(policy);
  ballotNonce       = disclose(nonce);
  adminKey          = disclose(admin_pk(admin_secret_key()));
  phase             = BallotPhase.voting;
}

// Khusus admin. Menutup sendiri begitu suara pertama masuk, sehingga daftar
// pemilih tidak dapat berubah di tengah pemungutan suara.
export circuit registerVoters(leaves: Vector<8, Bytes<32>>, n: Uint<8>): [] {
  assert(disclose(admin_pk(admin_secret_key()) == adminKey), "Hanya admin yang boleh mendaftarkan pemilih");
  assert(phase == BallotPhase.voting, "Ballot sudah tidak dalam fase pemungutan suara");
  assert(voteCount.read() == 0, "Pendaftaran ditutup setelah suara pertama masuk");
  assert(n >= 1 && n <= 8, "Jumlah pendaftaran harus 1 sampai 8");

  // registeredCount bersifat publik, jadi siapa pun dapat memeriksa jumlah
  // credential yang benar-benar diterbitkan terhadap eligibleCount yang di-seal.
  const terpakai = registeredCount.read();
  assert(terpakai + (n as Uint<64>) <= eligibleCount, "Melebihi eligibleCount yang ditetapkan ballot");

  // Diurai manual, bukan for-loop, agar tidak bergantung pada sintaks perulangan.
  // Kondisi tiap cabang di-disclose karena keputusan meng-insert atau tidak
  // itu sendiri adalah operasi ledger bersyarat — compactc 0.31.1 mewajibkan
  // pengungkapan eksplisit untuk boolean apa pun yang menentukan apakah
  // sebuah operasi ledger dijalankan.
  if (disclose(n > 0)) { eligibility.insert(disclose(leaves[0])); }
  if (disclose(n > 1)) { eligibility.insert(disclose(leaves[1])); }
  if (disclose(n > 2)) { eligibility.insert(disclose(leaves[2])); }
  if (disclose(n > 3)) { eligibility.insert(disclose(leaves[3])); }
  if (disclose(n > 4)) { eligibility.insert(disclose(leaves[4])); }
  if (disclose(n > 5)) { eligibility.insert(disclose(leaves[5])); }
  if (disclose(n > 6)) { eligibility.insert(disclose(leaves[6])); }
  if (disclose(n > 7)) { eligibility.insert(disclose(leaves[7])); }

  registeredCount.increment(disclose(n as Uint<16>));
}

// Dipanggil voter. Membuktikan keanggotaan di pohon eligibility dalam zero-
// knowledge, membakar nullifier supaya credential yang sama tidak bisa dipakai
// dua kali, lalu mencatat commitment suara. Seluruh validasi berjalan sebelum
// mutasi ledger apa pun, sehingga tidak ada state yang berubah sebagian saat
// sebuah assert gagal.
export circuit castVote(): [] {
  assert(kernel.blockTimeLessThan(voteDeadline), "Batas waktu pemungutan suara sudah lewat");
  // Status assert fase ini sama dengan assert fase di tallyVote (lihat catatan
  // panjang di atas circuit itu): tidak ada state yang HANYA guard ini yang
  // menolaknya. phase meninggalkan voting hanya lewat tallyVote (butuh waktu blok
  // > voteDeadline) atau finalize (butuh waktu blok > tallyDeadline), dan waktu
  // blok tidak pernah mundur — jadi setiap kali phase != voting, guard deadline
  // satu baris di atas sudah gagal juga, dan karena ia ditulis lebih dulu,
  // pesannyalah yang benar-benar dilihat pengguna.
  //
  // Bedanya dengan tallyVote: di sini jaminan itu BERSANDAR pada assert
  // tallyDl > voteDl di constructor. Tanpa assert itu, ballot dengan
  // tallyDeadline < voteDeadline dapat difinalisasi selagi waktu blok masih
  // < voteDeadline, dan pada state itu assert fase inilah satu-satunya yang
  // menolak. Jadi baris ini bukan sekadar dokumentasi niat.
  assert(phase == BallotPhase.voting, "Ballot tidak sedang menerima suara");

  const cred = voter_credential();
  const daun = cred_leaf(cred);
  const path = eligibility_path();

  // Membuktikan credential ada di pohon eligibility tanpa membuka credential-nya.
  assert(disclose(path.leaf == daun), "Merkle path bukan untuk credential ini");
  const rt: MerkleTreeDigest = disclose(merkleTreePathRoot<10, Bytes<32>>(path));
  assert(eligibility.checkRoot(rt), "Anda tidak terdaftar sebagai pemilih pada ballot ini");

  const opsi = get_my_option();
  const salt = get_my_salt();
  assert(disclose(opsi < optionCount), "Pilihan di luar opsi yang tersedia");

  // Satu credential, satu suara.
  const nf: Bytes<32> = disclose(vote_nullifier(ballotNonce, cred));
  assert(!nullifiers.member(nf), "Credential ini sudah dipakai memilih");
  nullifiers.insert(nf);

  // Yang masuk ledger hanyalah hash. Tidak ada satu bit pun tentang pilihan.
  commitments.insert(disclose(vote_commitment(opsi, salt)));
  voteCount.increment(1);

  // Disimpan lokal agar pemilih dapat membuka suaranya pada fase tally.
  store_opening(opsi, salt);
}

// Dipanggil voter, setelah voteDeadline, untuk membuka commitment suaranya
// sendiri. Membuktikan dalam zero-knowledge bahwa commitment yang dibuka ada
// di pohon commitments, TANPA mengungkap yang mana — hanya opsi yang terpilih
// yang menjadi publik. Nullifier tally diturunkan dari salt, bukan dari
// commitment, sehingga tidak ada cara menghubungkan "satu suara untuk opsi X"
// kembali ke commitment mana pun, apalagi ke pemilihnya — inilah yang membuat
// pembukaan ini tidak dapat dilacak walau hasilnya sudah dipublikasikan.
//
// Tidak ada circuit closeVoting terpisah. Transisi voting -> tallying
// dilakukan secara malas oleh pembuka suara pertama, di dalam circuit ini —
// bukan lewat circuit penutup tersendiri. Circuit penutup akan menciptakan
// jebakan liveness: bila tidak ada yang memanggilnya, suara tidak akan pernah
// bisa dibuka sama sekali, dan ballot mati dengan seluruh suaranya utuh tapi
// tidak dapat dihitung.
//
// CATATAN (Task 7, DIKOREKSI pada gelombang perbaikan review branch).
// Klaim yang benar tentang assert phase != finalized di baris pertama circuit
// ini adalah soal JANGKAUAN, bukan soal urutan: tidak ada state yang HANYA
// guard ini yang menolaknya. Begitu finalize() berhasil, waktu blok sudah pasti
// > tallyDeadline (itu prasyarat finalize sendiri) dan waktu blok tidak pernah
// mundur, sehingga guard blockTimeLessThan(tallyDeadline) juga pasti gagal pada
// state yang sama.
//
// Versi sebelumnya menulis bahwa guard tallyDeadline "SELALU sudah menolak
// lebih dulu". Itu KELIRU dan berbahaya untuk dijadikan premis: urutan evaluasi
// mengikuti urutan penulisan, dan assert fase ditulis paling atas. Setelah
// finalisasi, pesan yang benar-benar diterima pengguna adalah "Ballot sudah
// difinalisasi" — bukan "Batas waktu pembukaan suara sudah lewat". Siapa pun
// yang menyusun ulang atau menghapus guard di sini harus bernalar dari fakta
// itu, bukan dari premis yang salah.
//
// Baris ini dipertahankan justru karena pesannya lebih tepat menjelaskan
// keadaan kepada pengguna, dan sebagai pertahanan berlapis bila guard waktu
// suatu saat berubah.
export circuit tallyVote(): [] {
  assert(phase != BallotPhase.finalized, "Ballot sudah difinalisasi");
  assert(kernel.blockTimeGreaterThan(voteDeadline), "Pemungutan suara masih berlangsung");
  assert(kernel.blockTimeLessThan(tallyDeadline), "Batas waktu pembukaan suara sudah lewat");

  const opsi = get_my_option();
  const salt = get_my_salt();
  const c    = vote_commitment(opsi, salt);
  const path = commitment_path();

  // Membuktikan commitment ini ada di pohon, tanpa membuka commitment yang mana.
  assert(disclose(path.leaf == c), "Merkle path bukan untuk commitment ini");
  const rt: MerkleTreeDigest = disclose(merkleTreePathRoot<10, Bytes<32>>(path));
  assert(commitments.checkRoot(rt), "Commitment tidak ditemukan pada ballot ini");

  // Nullifier tally diturunkan dari salt yang rahasia — BUKAN dari commitment.
  // Inilah yang membuat "satu suara untuk opsi X" tidak dapat dihubungkan
  // kembali ke commitment mana pun, apalagi ke pemilihnya.
  const tnf: Bytes<32> = disclose(tally_nullifier(salt));
  assert(!tallyNullifiers.member(tnf), "Suara ini sudah pernah dibuka");

  // Seluruh validasi di atas sudah lulus; baru sekarang ledger dimutasi.
  // Transisi fase dulu (lihat komentar di atas circuit ini), lalu nullifier,
  // lalu tally itu sendiri.
  if (phase == BallotPhase.voting) { phase = BallotPhase.tallying; }

  tallyNullifiers.insert(tnf);

  const opsiPublik: Uint<8> = disclose(opsi);
  if (tallies.member(opsiPublik)) {
    tallies.insert(opsiPublik, (tallies.lookup(opsiPublik) + 1) as Uint<64>);
  } else {
    tallies.insert(opsiPublik, 1);
  }
  talliedCount.increment(1);
}

// Terbuka untuk siapa saja setelah tallyDeadline lewat — bukan hanya admin,
// karena finalisasi hanya menandai fakta yang sudah publik (tallyDeadline
// sudah lewat), bukan sebuah keputusan yang butuh otorisasi. Memberi tanda
// finalitas yang eksplisit di on-chain, bukan sekadar turunan waktu di sisi
// tampilan.
//
// Diterima dari fase apa pun selain finalized — SENGAJA BUKAN
// assert(phase == BallotPhase.tallying, ...). phase hanya berpindah ke
// tallying secara malas ketika pembuka suara pertama memanggil tallyVote
// (lihat komentar di tallyVote). Sebuah ballot yang tidak pernah dibuka satu
// suara pun (mis. tidak ada voter yang kembali setelah voteDeadline) akan
// tetap berada di fase voting selamanya; mewajibkan phase == tallying di sini
// akan membuat ballot semacam itu tidak dapat difinalisasi sama sekali —
// jebakan liveness yang sama persis dengan alasan closeVoting dihapus sebagai
// circuit terpisah (lihat komentar di tallyVote).
export circuit finalize(): [] {
  assert(phase != BallotPhase.finalized, "Ballot sudah difinalisasi");
  assert(kernel.blockTimeGreaterThan(tallyDeadline), "Batas waktu pembukaan suara belum lewat");
  phase = BallotPhase.finalized;
}
