pragma language_version >= 0.23;

import CompactStandardLibrary;

// Ballot contract addresses, newest first.
export ledger ballots: List<Opaque<"string">>;
export ledger count:   Counter;

// Permissionless: anyone may register a ballot they have deployed.
// Entries that do not resolve to a valid ballot contract are filtered client-side.
export circuit register(addr: Opaque<"string">): [] {
  ballots.pushFront(disclose(addr));
  count.increment(1);
}
